# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /data volume).
.git

# The Dockerfile is not part of what the image runs.  Keeping it (and this file) out of the context means an
# edit to either does not invalidate COPY . . below - and the ten-minute engine compile that follows it.
Dockerfile
.dockerignore

# local Python environment (rebuilt in the image)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# setup.py outputs and downloads (engine, packs, models, logs)
/engine/
/build/
/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
third_party/*.zip
*.done
*.log
strata-*.json
strata-*.txt
run-*.sh
run-*.bat
